# 5 Daily Scheduled Publishing Times (24h format HH:mm, local timezone)
PUBLISH_SLOTS=09:00,12:00,15:00,18:00,21:00

# File Safety: Delete local image from Images/ only after confirmed Pinterest publication
DELETE_AFTER_UPLOAD=true

