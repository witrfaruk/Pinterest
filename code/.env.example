# Server Configuration
PORT=3000
HOST=127.0.0.1

# Pinterest Official API & OAuth Configuration
PINTEREST_APP_ID=your_pinterest_app_id
PINTEREST_APP_SECRET=your_pinterest_app_secret
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
PINTEREST_REFRESH_TOKEN=
PINTEREST_USE_SANDBOX=false

# Ollama Local Configuration (Vision Model)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b

# 5 Daily Scheduled Publishing Times (24h format HH:mm, local timezone)
# 17:30 (5:30 PM IST), 19:30 (7:30 PM IST), 21:30 (9:30 PM IST), 23:30 (11:30 PM IST), 01:30 (1:30 AM IST)
PUBLISH_SLOTS=17:30,19:30,21:30,23:30,01:30


# File Safety: Delete local image from Images/ only after confirmed Pinterest publication
DELETE_AFTER_UPLOAD=true

# Supabase Cloud Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=pinterest-queue
DASHBOARD_PASSWORD=your_secure_password_here

# Google Spreadsheet Configuration (Optional)
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SHEET_NAME=example_pinterest
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_apps_script_url/exec
